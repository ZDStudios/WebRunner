# Copy to .env and adjust. Every value is optional.
# docker compose reads this file automatically.

# Timezone for schedules and timestamps (IANA name).
TZ=Europe/London

# First-run account. If the password is left blank, WebRunner generates one and
# prints it to the log / initial-password.txt on first start.
WEBRUNNER_ADMIN_USER=admin
WEBRUNNER_ADMIN_PASSWORD=

# Session signing key. Set this so logins survive a container rebuild.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBRUNNER_SECRET=

# --- less commonly changed -------------------------------------------------

# WEBRUNNER_HOST=0.0.0.0
# WEBRUNNER_PORT=8770
# WEBRUNNER_DATA_DIR=/data

# Default shell for shell blocks.
# WEBRUNNER_SHELL=/bin/bash

# Set when serving over HTTPS so the session cookie carries the Secure flag.
# WEBRUNNER_SECURE_COOKIE=1

# Days a login stays valid.
# WEBRUNNER_SESSION_DAYS=14

# Max captured output per run, in bytes.
# WEBRUNNER_MAX_OUTPUT=524288

# debug | info | warning | error
# WEBRUNNER_LOG_LEVEL=info

# DANGER: turns off authentication entirely. Only for a socket bound to
# 127.0.0.1 on a machine you trust completely.
# WEBRUNNER_AUTH_DISABLED=0
